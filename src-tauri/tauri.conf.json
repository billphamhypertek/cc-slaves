{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cc-slaves",
  "version": "../package.json",
  "identifier": "com.ccslaves.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "boot",
        "title": "cc-slaves",
        "url": "index.html",
        "width": 560,
        "height": 360,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwQzlCOTY5NjFEM0VEMDIKUldRQzdkTmhhYm5KOEhlSnBSYzNMdXA0NWhFK0QzaS9mUlduV1RKKzdsWHhnZ1ZzcmV3ZXZMaUQK",
      "endpoints": ["https://github.com/billphamhypertek/cc-slaves/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  }
}
