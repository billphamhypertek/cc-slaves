{
  "name": "cc-slaves",
  "version": "0.3.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "fake-cbm",
    "fake-claude",
    "fake-mcp",
    "web"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "bun test engine/test",
    "web:dev": "bun web/dev/run.ts",
    "web:build": "bun run --cwd web build && bun scripts/check-bundle.ts",
    "test:web": "bun test web/test",
    "build:engine": "bun build --compile engine/src/main.ts --outfile dist/cc-slaves",
    "engine:dev": "bun engine/src/main.ts",
    "app:dev": "bun x tauri dev",
    "app:build": "bash scripts/app-build.sh",
    "test:it": "bun test engine/it",
    "test:e2e": "bunx playwright test",
    "smoke": "bun scripts/smoke/run.ts all",
    "release:bump": "bun scripts/release/bump.ts",
    "lint": "bun scripts/lint.ts",
    "check:structure": "bun scripts/check-structure.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "check:dead": "bun scripts/check-dead.ts",
    "test:scripts": "bun test scripts/test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.43.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.70.1"
  }
}
